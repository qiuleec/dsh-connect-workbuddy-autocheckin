{
  "name": "dsh-connect-workbuddy-autocheckin",
  "displayName": "DSH WorkBuddy Auto Check-in",
  "description": "Automatically claim the WorkBuddy CN daily check-in reward once a day, without pressing the button.",
  "version": "0.1.0",
  "author": "abnor",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "checkin",
    "automation"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-connect-workbuddy-autocheckin": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0 || >=4.0.2 <5.0.0",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0 || >=3.18.2 <4.0.0",
    "dsh-connect-workbuddy": ">=3.0.0 <4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0 || >=4.0.2 <5.0.0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0 || >=3.18.2 <4.0.0",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependenciesMeta": {
    "dsh-connect-workbuddy": {
      "optional": false
    }
  }
}
